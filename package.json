{
  "name": "checkmcp",
  "version": "0.2.1",
  "description": "Testing for MCP servers: an in-memory harness and matchers for your own tests, and npx checkmcp, one command that checks any server against the spec.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregkozakiewicz/checkmcp.git"
  },
  "homepage": "https://gregkozakiewicz.github.io/checkmcp/",
  "bugs": "https://github.com/gregkozakiewicz/checkmcp/issues",
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "test",
    "conformance",
    "vitest",
    "jest"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "default": "./dist/matchers.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run && npm run build && node tests/e2e/run.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "bin": {
    "checkmcp": "dist/cli.js"
  },
  "author": "Greg Kozakiewicz"
}
